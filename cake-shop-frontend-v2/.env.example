# Example environment variables for Cake Shop frontend
# Copy this to .env (locally) and replace values with your real endpoints

# Base backend URL (no trailing /api)
REACT_APP_BACKEND_URL=https://your-backend.example.com

# Full API base URL (optional). If omitted, defaults to ${REACT_APP_BACKEND_URL}/api
# REACT_APP_API_URL=https://your-backend.example.com/api
